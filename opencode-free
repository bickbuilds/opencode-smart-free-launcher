#!/usr/bin/env python3
"""Launch OpenCode with the highest-ranked currently-free OpenCode Zen model."""

from __future__ import annotations

import fcntl
import json
import os
import re
import shutil
import subprocess
import sys
import time
import urllib.error
import urllib.request
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


CATALOG_URL = "https://models.dev/api.json"
STATS_URL = "https://stats.opencode.ai/"
AA_API_URL = "https://artificialanalysis.ai/api/v2/language/models/free"
AA_API_KEY_ENV = "ARTIFICIAL_ANALYSIS_API_KEY"
CACHE_TTL_SECONDS = 24 * 60 * 60
FALLBACK_CACHE_TTL_SECONDS = 60 * 60
AA_PAGE_SIZE = 200
# The Coding Agent Index is the closest published analogue to how this launcher
# ranks: it weights DeepSWE, Terminal-Bench 4.0 and SWE-Atlas-QnA. Each entry is
# tried in order, so a model missing the preferred index still ranks on the next
# one rather than dropping out of contention entirely.
AA_INDEX_FIELDS = (
    "artificial_analysis_coding_index",
    "artificial_analysis_agentic_index",
    "artificial_analysis_intelligence_index",
)
# Zen-only distribution qualifiers, peeled off when matching a Zen id against a
# benchmark publisher's model name.
AA_ID_SUFFIXES = ("-free", "-preview", "-contributor")
SUBCOMMANDS = {
    "acp",
    "api",
    "auth",
    "debug",
    "mcp",
    "mini",
    "models",
    "pair",
    "plugin",
    "reload",
    "run",
    "serve",
    "service",
    "session",
    "stats",
    "uninstall",
    "update",
    "upgrade",
}
RESUME_FLAGS = {"--continue", "-c", "--session", "-s"}
PASSTHROUGH_FLAGS = {"--help", "-h", "--version", "-v", "--completions"}

# Used only if the catalog is reachable but the public usage page is not. The
# chosen entry must still be present in the live catalog with zero input/output
# cost and tool support before it can be selected.
FALLBACK_PREFERENCE = [
    "space-bunny-free",
    "deepseek-v4-flash-free",
    "muse-spark-1.3-contributor-free",
    "mimo-v2.6-flash-free",
    "nemotron-3-ultra-free",
    "longcat-2.5-preview-free",
]


class SelectionError(RuntimeError):
    pass


def launcher_config_path() -> Path:
    root = os.environ.get("XDG_CONFIG_HOME")
    base = Path(root) if root else Path.home() / ".config"
    return base / "opencode-smart-launcher" / "config.json"


def find_real_binary() -> str:
    configured: list[str] = []
    if os.environ.get("OPENCODE_REAL_BINARY"):
        configured.append(os.environ["OPENCODE_REAL_BINARY"])
    try:
        config = json.loads(launcher_config_path().read_text(encoding="utf-8"))
        if isinstance(config, dict) and isinstance(config.get("real_binary"), str):
            configured.append(config["real_binary"])
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        pass

    configured.append(str(Path.home() / ".opencode" / "bin" / "opencode"))
    discovered = shutil.which("opencode")
    if discovered:
        configured.append(discovered)

    launcher = Path(__file__).resolve()
    for value in configured:
        candidate = Path(value).expanduser()
        try:
            if candidate.is_file() and candidate.resolve() != launcher:
                return str(candidate.resolve())
        except OSError:
            continue
    raise SelectionError(
        "real OpenCode binary not found; rerun the smart-launcher installer or set OPENCODE_REAL_BINARY"
    )


def cache_dir() -> Path:
    root = os.environ.get("XDG_CACHE_HOME")
    return Path(root) / "opencode-free-launcher" if root else Path.home() / ".cache" / "opencode-free-launcher"


def cache_path() -> Path:
    return cache_dir() / "selection.json"


def fetch_text(url: str, timeout: float = 12.0, headers: dict[str, str] | None = None) -> str:
    request_headers = {"User-Agent": "argus-opencode-free-launcher/1.0"}
    request_headers.update(headers or {})
    request = urllib.request.Request(url, headers=request_headers)
    with urllib.request.urlopen(request, timeout=timeout) as response:
        return response.read().decode("utf-8")


def aa_api_key() -> str:
    key = os.environ.get(AA_API_KEY_ENV, "").strip()
    if not key:
        raise SelectionError(
            f"{AA_API_KEY_ENV} is not set; get a free key at https://artificialanalysis.ai/data-api"
        )
    return key


def free_candidates(catalog: dict[str, Any]) -> list[dict[str, Any]]:
    provider = catalog.get("opencode")
    if not isinstance(provider, dict):
        raise SelectionError("Models.dev did not return the OpenCode Zen provider")
    models = provider.get("models")
    if not isinstance(models, dict):
        raise SelectionError("Models.dev returned an invalid OpenCode Zen catalog")

    result: list[dict[str, Any]] = []
    for model_id, raw in models.items():
        if not isinstance(raw, dict):
            continue
        cost = raw.get("cost")
        if not isinstance(cost, dict) or cost.get("input") != 0 or cost.get("output") != 0:
            continue
        if raw.get("tool_call") is not True or raw.get("status") == "deprecated":
            continue
        if str(model_id).startswith("jev-"):
            continue
        result.append(
            {
                "id": str(model_id),
                "name": str(raw.get("name") or model_id),
                "context": int((raw.get("limit") or {}).get("context") or 0),
            }
        )
    if not result:
        raise SelectionError("No tool-capable zero-cost OpenCode Zen models are currently listed")
    return result


def usage_scores(html: str) -> dict[str, float]:
    scores: dict[str, float] = {}
    # The public page embeds both daily and weekly leaderboard rows. Keeping the
    # largest token value for each model reliably selects the weekly figure.
    pattern = re.compile(
        r'model:"(?P<model>[a-zA-Z0-9._-]+)"[^{}]{0,220}?tokens:(?P<tokens>[0-9.]+)[^{}]{0,120}?rank:[0-9]+'
    )
    for match in pattern.finditer(html):
        model = match.group("model")
        tokens = float(match.group("tokens"))
        scores[model] = max(scores.get(model, 0.0), tokens)
    return scores


def usage_key(model_id: str) -> str:
    if model_id.endswith("-contributor-free"):
        return model_id[: -len("-free")]
    if model_id.endswith("-free"):
        return model_id[: -len("-free")]
    return model_id


def rank_candidates_by_usage(candidates: list[dict[str, Any]], scores: dict[str, float]) -> tuple[dict[str, Any], str]:
    scored = [(scores.get(usage_key(item["id"]), 0.0), item) for item in candidates]
    best_score, best = max(scored, key=lambda pair: (pair[0], pair[1]["context"], pair[1]["id"]))
    if best_score > 0:
        return best, "OpenCode public weekly usage"

    by_id = {item["id"]: item for item in candidates}
    for model_id in FALLBACK_PREFERENCE:
        if model_id in by_id:
            return by_id[model_id], "verified fallback preference"
    return max(candidates, key=lambda item: (item["context"], item["id"])), "verified context-size fallback"


def model_key(value: str) -> str:
    return re.sub(r"[^a-z0-9]", "", value.lower())


def aa_index_payload() -> dict[str, Any]:
    """Fetch every page of the free-tier Artificial Analysis model list."""
    headers = {"x-api-key": aa_api_key(), "Accept": "application/json"}
    collected: list[dict[str, Any]] = []
    version: Any = None
    page = 1
    while True:
        separator = "&" if "?" in AA_API_URL else "?"
        url = f"{AA_API_URL}{separator}page={page}&page_size={AA_PAGE_SIZE}"
        try:
            body = json.loads(fetch_text(url, timeout=20.0, headers=headers))
        except json.JSONDecodeError as error:
            raise SelectionError(f"Artificial Analysis returned invalid JSON: {error}") from error
        if not isinstance(body, dict):
            raise SelectionError("Artificial Analysis returned an unexpected payload shape")

        rows = body.get("data")
        if not isinstance(rows, list):
            raise SelectionError("Artificial Analysis response had no model list")
        collected.extend(row for row in rows if isinstance(row, dict))

        pagination = body.get("pagination")
        if not isinstance(pagination, dict):
            raise SelectionError("Artificial Analysis response had no pagination block")
        version = body.get("intelligence_index_version", version)

        if not pagination.get("has_more"):
            break
        page += 1
        if page > 50:
            raise SelectionError("Artificial Analysis pagination did not terminate")

    if not collected:
        raise SelectionError("Artificial Analysis returned no language models")
    return {"models": collected, "intelligence_index_version": version}


def aa_index_snapshot() -> tuple[dict[str, dict[str, Any]], Any]:
    """Return AA scores keyed by normalised name, plus the reported index version.

    Freshness is implicit: this is a live API call, so the existing 24h selection
    cache bounds how old a decision can be. There is no page timestamp to police,
    which is what previously forced a hard fallback when a third-party mirror went
    quiet.
    """
    payload = aa_index_payload()
    scores: dict[str, dict[str, Any]] = {}
    for row in payload["models"]:
        evaluations = row.get("evaluations")
        if not isinstance(evaluations, dict):
            continue
        indices = {
            name: float(evaluations[name])
            for name in AA_INDEX_FIELDS
            if isinstance(evaluations.get(name), (int, float))
            and not isinstance(evaluations.get(name), bool)
        }
        if not indices:
            continue
        for raw_name in (row.get("name"), row.get("slug")):
            if isinstance(raw_name, str) and raw_name:
                scores.setdefault(
                    model_key(raw_name), {"aa_name": raw_name, "indices": dict(indices)}
                )
    if not scores:
        raise SelectionError("Artificial Analysis returned no usable index scores")
    return scores, payload["intelligence_index_version"]


def aa_match_keys(candidate: dict[str, Any]) -> list[str]:
    """Normalised keys a Zen model id can legitimately match on.

    Zen appends distribution qualifiers the benchmark publisher has no reason to
    know about ("-free", "-preview-free", "-contributor-free"), so each tier is
    peeled off in turn and every intermediate form is offered as a candidate key.
    This replaces a hardcoded alias for a single Muse model.
    """
    # Try both exact identifiers before stripping either one. Each subsequent
    # tier removes one distribution qualifier; variant names remain intact.
    current = [
        re.sub(r"\s+", "-", str(candidate.get(field) or "").strip().lower())
        for field in ("id", "name")
    ]
    keys: list[str] = []
    while current:
        stripped = []
        for value in current:
            key = model_key(value)
            if key and key not in keys:
                keys.append(key)
            for suffix in AA_ID_SUFFIXES:
                if value.endswith(suffix):
                    stripped.append(value[: -len(suffix)])
                    break
        current = stripped
    return keys


def aa_score_for(candidate: dict[str, Any], scores: dict[str, dict[str, Any]]) -> dict[str, Any] | None:
    for key in aa_match_keys(candidate):
        if key in scores:
            return scores[key]
    return None


def rank_candidates_by_aa(
    candidates: list[dict[str, Any]], scores: dict[str, dict[str, Any]]
) -> tuple[dict[str, Any], dict[str, Any]]:
    matched = [(aa_score_for(item, scores), item) for item in candidates]
    matched = [(score, item) for score, item in matched if score is not None]
    if not matched:
        raise SelectionError("Artificial Analysis has no index scores matching the current free models")

    # Rank on a single index across all candidates. The Coding, Agentic and
    # Intelligence indices are separately calibrated, so mixing them in one
    # comparison would compare incomparable numbers. The first field that covers
    # any candidate wins, and only candidates carrying that field compete.
    for field in AA_INDEX_FIELDS:
        ranked = [
            (score["indices"][field], item, score["aa_name"])
            for score, item in matched
            if field in score["indices"]
        ]
        if not ranked:
            continue
        value, selected, publisher_name = max(
            ranked, key=lambda triple: (triple[0], triple[1]["context"], triple[1]["id"])
        )
        scored_ids = {item["id"] for _, item, _ in ranked}
        any_matched_ids = {item["id"] for _, item in matched}
        return selected, {
            "aa_index": value,
            "aa_field": field,
            "aa_name": publisher_name,
            "scored_count": len(scored_ids),
            "benchmarked_count": len(any_matched_ids),
            # Every free candidate the publisher did not score at all, so a
            # popular but unbenchmarked model is disclosed rather than dropped.
            "unscored_ids": sorted(
                item["id"] for item in candidates if item["id"] not in any_matched_ids
            ),
        }
    raise SelectionError("Artificial Analysis returned no comparable index scores")


def read_cache() -> dict[str, Any] | None:
    try:
        value = json.loads(cache_path().read_text(encoding="utf-8"))
    except (FileNotFoundError, json.JSONDecodeError, OSError):
        return None
    return value if isinstance(value, dict) else None


def cache_is_fresh(value: dict[str, Any], now: float) -> bool:
    ttl = FALLBACK_CACHE_TTL_SECONDS if value.get("ranking_source") == "fallback" else CACHE_TTL_SECONDS
    return (
        value.get("ranking_source") in ("aa-api", "fallback")
        and isinstance(value.get("model"), str)
        and isinstance(value.get("selected_at"), (int, float))
        and now - float(value["selected_at"]) < ttl
    )


def write_cache(value: dict[str, Any]) -> None:
    directory = cache_dir()
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    temporary = directory / f"selection.{os.getpid()}.tmp"
    temporary.write_text(json.dumps(value, indent=2) + "\n", encoding="utf-8")
    temporary.chmod(0o600)
    temporary.replace(cache_path())


def refresh_selection(now: float) -> dict[str, Any]:
    try:
        catalog = json.loads(fetch_text(CATALOG_URL))
    except (json.JSONDecodeError, OSError, urllib.error.URLError) as error:
        raise SelectionError(f"could not refresh the live model catalog: {error}") from error
    if not isinstance(catalog, dict):
        raise SelectionError("the live model catalog was not a JSON object")

    candidates = free_candidates(catalog)
    selection_details: dict[str, Any]
    try:
        aa_scores, index_version = aa_index_snapshot()
        selected, aa = rank_candidates_by_aa(candidates, aa_scores)
        selection_details = {
            "basis": f"Artificial Analysis {aa['aa_field'].removeprefix('artificial_analysis_').removesuffix('_index')}",
            "ranking_source": "aa-api",
            "intelligence_index_version": index_version,
            "aa_index": aa["aa_index"],
            "aa_field": aa["aa_field"],
            "aa_name": aa["aa_name"],
            "ranked_count": aa["scored_count"],
            "benchmarked_count": aa["benchmarked_count"],
            "candidate_count": len(candidates),
            "unscored_ids": aa["unscored_ids"],
        }
    except (OSError, urllib.error.URLError, SelectionError) as error:
        fallback_reason = str(error)
        try:
            usage = usage_scores(fetch_text(STATS_URL))
        except (OSError, urllib.error.URLError):
            usage = {}
        selected, fallback_basis = rank_candidates_by_usage(candidates, usage)
        selection_details = {
            "basis": f"FALLBACK: {fallback_basis}",
            "ranking_source": "fallback",
            "fallback_reason": fallback_reason,
        }
    return {
        "schema": 1,
        "model": f"opencode/{selected['id']}",
        "name": selected["name"],
        **selection_details,
        "candidate_count": len(candidates),
        "selected_at": now,
    }


def print_status(selection: dict[str, Any]) -> None:
    fallback = selection.get("ranking_source") == "fallback"
    print("OpenCode free-model status")
    print(f"Health: {'DEGRADED - FALLBACK ACTIVE' if fallback else 'OK - Artificial Analysis ranking active'}")
    print(f"Model: {selection['name']} ({selection['model']})")
    print(f"Ranking: {selection['basis']}")
    if selection.get("aa_index") is not None:
        field = selection.get("aa_field") or "index"
        print(f"AA index: {selection['aa_index']} (source: {field})")
    if selection.get("intelligence_index_version") is not None:
        print(f"AA Intelligence Index version: {selection['intelligence_index_version']}")
    unscored = selection.get("unscored_ids")
    if unscored:
        # A successful ranking says nothing about models the publisher has not
        # scored, so surface them rather than implying full coverage.
        benchmarked = selection.get("benchmarked_count")
        total = selection.get("candidate_count")
        if benchmarked and total:
            print(f"Coverage: {benchmarked} of {total} free models scored by AA")
        print(f"Not scored by AA ({len(unscored)}): {', '.join(unscored)}")
    if selection.get("fallback_reason"):
        print(f"Fallback reason: {selection.get('fallback_reason')}")
    checked = datetime.fromtimestamp(float(selection["selected_at"]), timezone.utc).isoformat()
    print(f"Selection checked: {checked}")
    print(f"Cache: {selection.get('cache', 'unknown')}")


def select_model(force_refresh: bool = False) -> dict[str, Any]:
    directory = cache_dir()
    directory.mkdir(parents=True, exist_ok=True, mode=0o700)
    lock_path = directory / "selection.lock"
    with lock_path.open("a+", encoding="utf-8") as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        now = time.time()
        cached = read_cache()
        if not force_refresh and cached and cache_is_fresh(cached, now):
            return {**cached, "cache": "fresh"}
        try:
            refreshed = refresh_selection(now)
        except SelectionError:
            # A selection less than 24 hours old was verified recently enough to
            # remain safe during a transient refresh failure. Older values fail
            # closed rather than risk silently launching a newly-paid model.
            if cached and cache_is_fresh(cached, now):
                return {**cached, "cache": "refresh-failed"}
            raise
        write_cache(refreshed)
        return {**refreshed, "cache": "refreshed"}


def is_resume(args: list[str]) -> bool:
    return any(arg in RESUME_FLAGS for arg in args)


def is_noninteractive_command(args: list[str]) -> bool:
    if any(arg in PASSTHROUGH_FLAGS for arg in args):
        return True
    for arg in args:
        if arg == "--":
            return False
        if arg.startswith("-"):
            continue
        return arg in SUBCOMMANDS
    return False


def config_content_with_model(model: str) -> str:
    raw = os.environ.get("OPENCODE_CONFIG_CONTENT", "")
    if not raw:
        config: dict[str, Any] = {}
    else:
        try:
            parsed = json.loads(raw)
        except json.JSONDecodeError as error:
            raise SelectionError(f"OPENCODE_CONFIG_CONTENT is invalid JSON: {error}") from error
        if not isinstance(parsed, dict):
            raise SelectionError("OPENCODE_CONFIG_CONTENT must be a JSON object")
        config = parsed
    config["model"] = model
    return json.dumps(config, separators=(",", ":"))


def target_directory(args: list[str]) -> str:
    flags_with_values = {"--server", "--prompt", "--log-level", "--session", "-s"}
    skip_next = False
    for index, arg in enumerate(args):
        if skip_next:
            skip_next = False
            continue
        if arg in flags_with_values:
            skip_next = True
            continue
        if arg == "--" and index + 1 < len(args):
            return str(Path(args[index + 1]).expanduser().resolve())
        if not arg.startswith("-"):
            return str(Path(arg).expanduser().resolve())
    return str(Path.cwd().resolve())


def create_explicit_session(binary: str, model: str, directory: str) -> str:
    try:
        provider_id, model_id = model.split("/", 1)
    except ValueError as error:
        raise SelectionError(f"invalid selected model reference: {model}") from error
    payload = json.dumps(
        {
            "model": {"providerID": provider_id, "id": model_id},
            "location": {"directory": directory},
        },
        separators=(",", ":"),
    )
    try:
        result = subprocess.run(
            [binary, "api", "session.create", "--data", payload],
            check=True,
            capture_output=True,
            text=True,
            timeout=30,
        )
        response = json.loads(result.stdout)
        session = response["data"]
        session_id = session["id"]
        selected = session.get("model") or {}
    except (subprocess.SubprocessError, json.JSONDecodeError, KeyError, TypeError) as error:
        detail = getattr(error, "stderr", "") or str(error)
        raise SelectionError(f"could not create an explicit-model OpenCode session: {detail.strip()}") from error
    if selected.get("providerID") != provider_id or selected.get("id") != model_id:
        raise SelectionError("OpenCode created the session with a different model than requested")
    if not isinstance(session_id, str) or not session_id.startswith("ses"):
        raise SelectionError("OpenCode returned an invalid session ID")
    return session_id


def main() -> int:
    args = sys.argv[1:]
    dry_run = "--smart-free-dry-run" in args
    status = "--smart-free-status" in args
    force_refresh = "--smart-free-refresh" in args
    args = [
        arg
        for arg in args
        if arg not in {"--smart-free-dry-run", "--smart-free-status", "--smart-free-refresh"}
    ]

    try:
        binary = find_real_binary()
    except SelectionError as error:
        print(f"OpenCode free launcher: {error}", file=sys.stderr)
        return 127

    if is_resume(args) or is_noninteractive_command(args):
        if dry_run:
            print(json.dumps({"action": "passthrough", "args": args}))
            return 0
        os.execv(binary, [binary, *args])

    try:
        selection = select_model(force_refresh=force_refresh)
        content = config_content_with_model(selection["model"])
    except SelectionError as error:
        print(f"OpenCode free launcher: {error}", file=sys.stderr)
        print("Refusing to launch with an unverified or potentially paid model.", file=sys.stderr)
        return 2

    if dry_run:
        print(json.dumps({"action": "launch", **selection}, indent=2))
        return 0
    if status:
        print_status(selection)
        return 0

    # The V2 TUI connects to a shared background service. Inline config belongs
    # to the server process, so setting it only on the TUI client cannot change
    # that service's default. Create the new session with an explicit model and
    # open that exact session instead. Resume requests remain untouched above.
    if "--standalone" not in args and "--server" not in args:
        try:
            session_id = create_explicit_session(binary, selection["model"], target_directory(args))
        except SelectionError as error:
            print(f"OpenCode free launcher: {error}", file=sys.stderr)
            print("Refusing to launch a session whose free model cannot be enforced.", file=sys.stderr)
            return 2
        args = ["--session", session_id, *args]

    if selection.get("ranking_source") == "fallback":
        print("WARNING: Artificial Analysis ranking unavailable - FALLBACK ACTIVE.", file=sys.stderr)
        print(f"Reason: {selection.get('fallback_reason', 'unknown')}", file=sys.stderr)
    else:
        print(
            f"Artificial Analysis ranking active: {selection.get('aa_index')} "
            f"({selection.get('aa_field')}, index v{selection.get('intelligence_index_version')}).",
            file=sys.stderr,
        )
    print(
        f"OpenCode free launcher: {selection['name']} ({selection['model']}) "
        f"via {selection['basis']} [{selection['cache']}].", file=sys.stderr
    )
    print("Free-model session: do not submit private or confidential material.", file=sys.stderr)
    environment = os.environ.copy()
    environment["OPENCODE_CONFIG_CONTENT"] = content
    os.execve(binary, [binary, *args], environment)


if __name__ == "__main__":
    raise SystemExit(main())
